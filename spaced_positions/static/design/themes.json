 "schema": {
  "bg": {
   "type": "color",
   "description": "Workspace background"
  },
  "bg-alt": {
   "type": "color",
   "description": "Pane headers, status line, app bar"
  },
  "surface": {
   "type": "color",
   "description": "Inputs and raised elements: keycaps, chips"
  },
  "line": {
   "type": "color",
   "description": "Rules between panes, borders"
  },
  "text": {
   "type": "color",
   "description": "Main text"
  },
  "text-sub": {
   "type": "color",
   "description": "Secondary text, labels, axes"
  },
  "main": {
   "type": "color",
   "description": "Accent: focus, cursor, primary buttons, current mode"
  },
  "main-text": {
   "type": "color",
   "description": "Text on the accent colour"
  },
  "good": {
   "type": "color",
   "description": "Correct, good move, positive delta"
  },
  "bad": {
   "type": "color",
   "description": "Wrong, bad move, negative delta"
  },
  "warn": {
   "type": "color",
   "description": "Dubious move, warnings"
  },
  "info": {
   "type": "color",
   "description": "Neutral highlights, links"
  },
  "special": {
   "type": "color",
   "description": "Rewards: records, milestones, level-ups"
  },
  "sq-light": {
   "type": "color",
   "description": "Light squares"
  },
  "sq-dark": {
   "type": "color",
   "description": "Dark squares"
  },
  "sq-lastmove": {
   "type": "color",
   "description": "Last-move overlay (with alpha)"
  },
  "sq-selected": {
   "type": "color",
   "description": "Selected-piece overlay (with alpha)"
  },
  "sq-check": {
   "type": "color",
   "description": "King-in-check overlay (with alpha)"
  },
  "sq-hint": {
   "type": "color",
   "description": "Hint overlay (with alpha)"
  },
  "arrow-green": {
   "type": "color",
   "description": "Drawn arrows and circles: default colour"
  },
  "arrow-red": {
   "type": "color",
   "description": "Drawn arrows and circles with Shift"
  },
  "arrow-blue": {
   "type": "color",
   "description": "Drawn arrows and circles with Alt"
  },
  "arrow-yellow": {
   "type": "color",
   "description": "Drawn arrows and circles with Shift+Alt"
  },
  "arrow-engine": {
   "type": "color",
   "description": "Engine arrows (fade by rank)"
  },
  "board-border": {
   "type": "px",
   "description": "Board frame width",
   "min": 0,
   "max": 12
  },
  "board-coords": {
   "type": "enum",
   "description": "Coordinates",
   "values": [
    "inside",
    "outside",
    "off"
   ],
   "css": false
  },
  "piece-set": {
   "type": "enum",
   "description": "Piece set",
   "values": [
    "cburnett",
    "merida",
    "chessnut",
    "fantasy",
    "spatial",
    "celtic",
    "mpchess",
    "shapes",
    "rhosgfx",
    "kiwen-suwi",
    "totoy",
    "papercut"
   ],
   "css": false
  },
  "font-ui": {
   "type": "font",
   "description": "Interface font"
  },
  "font-mono": {
   "type": "font",
   "description": "Keycaps, ids, FEN/PGN, clocks"
  },
  "font-moves": {
   "type": "font",
   "description": "Move lists (allows a figurine font)"
  },
  "font-size": {
   "type": "px",
   "description": "Base font size",
   "min": 10,
   "max": 20
  },
  "type-ratio": {
   "type": "number",
   "description": "Modular scale for headings and big numbers",
   "min": 1.05,
   "max": 1.6
  },
  "density": {
   "type": "enum",
   "description": "Spacing unit: compact 3px, cozy 4px, comfortable 5px",
   "values": [
    "compact",
    "cozy",
    "comfortable"
   ],
   "var": "space",
   "css-values": {
    "compact": "3px",
    "cozy": "4px",
    "comfortable": "5px"
   }
  },
  "radius": {
   "type": "px",
   "description": "Corner radius",
   "min": 0,
   "max": 10
  },
  "rule": {
   "type": "px",
   "description": "Border width",
   "min": 1,
   "max": 3
  },
  "motion": {
   "type": "number",
   "description": "Animation speed factor: 0 = off, 1 = default",
   "min": 0,
   "max": 1.5
  },
  "board-motion": {
   "type": "ms",
   "description": "Piece animation",
   "min": 0,
   "max": 600
  },
  "figurines": {
   "type": "bool",
   "description": "Moves as figurines (♘f3) instead of letters (Nf3)",
   "css": false
  }
 },
