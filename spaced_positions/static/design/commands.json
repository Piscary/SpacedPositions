{
 "version": 1,
 "commands": {
  "pane.focus.next": {
   "title": "Focus the next pane",
   "group": "Panes",
   "handler": "client"
  },
  "pane.focus.prev": {
   "title": "Focus the previous pane",
   "group": "Panes",
   "handler": "client"
  },
  "pane.focus": {
   "title": "Focus pane N",
   "group": "Panes",
   "args": [
    {
     "name": "n",
     "type": "int"
    }
   ],
   "handler": "client"
  },
  "pane.focus.dir": {
   "title": "Focus the pane in a direction",
   "group": "Panes",
   "args": [
    {
     "name": "dir",
     "type": "enum",
     "values": [
      "left",
      "down",
      "up",
      "right"
     ]
    }
   ],
   "handler": "client"
  },
  "pane.split.vertical": {
   "title": "Split vertically (side by side)",
   "group": "Panes",
   "aliases": [
    "vsplit",
    "vs"
   ],
   "args": [
    {
     "name": "view",
     "type": "view",
     "optional": true
    }
   ],
   "undoable": true,
   "handler": "client"
  },
  "pane.split.horizontal": {
   "title": "Split horizontally (above / below)",
   "group": "Panes",
   "aliases": [
    "split",
    "sp"
   ],
   "args": [
    {
     "name": "view",
     "type": "view",
     "optional": true
    }
   ],
   "undoable": true,
   "handler": "client"
  },
  "pane.close": {
   "title": "Close pane",
   "group": "Panes",
   "aliases": [
    "close"
   ],
   "when": "panes > 1",
   "reason": "the last pane can't be closed",
   "undoable": true,
   "handler": "client"
  },
  "pane.only": {
   "title": "Only this pane (others become hidden buffers)",
   "group": "Panes",
   "aliases": [
    "only"
   ],
   "when": "panes > 1",
   "reason": "it is already the only pane",
   "undoable": true,
   "handler": "client"
  },
  "pane.buffers": {
   "title": "Hidden buffers",
   "group": "Panes",
   "aliases": [
    "buffers",
    "ls"
   ],
   "when": "buffers > 0",
   "reason": "no hidden buffers",
   "handler": "client"
  },
  "pane.buffer": {
   "title": "Show a hidden buffer in a split",
   "group": "Panes",
   "aliases": [
    "buffer",
    "b"
   ],
   "args": [
    {
     "name": "buffer",
     "type": "buffer"
    }
   ],
   "when": "buffers > 0",
   "reason": "no hidden buffers",
   "undoable": true,
   "hidden": true,
   "handler": "client"
  },
  "pane.view": {
   "title": "Change this pane's view",
   "group": "Panes",
   "aliases": [
    "view",
    "e"
   ],
   "args": [
    {
     "name": "view",
     "type": "view",
     "optional": true
    }
   ],
   "undoable": true,
   "handler": "client"
  },
  "pane.maximize": {
   "title": "Maximise / restore pane",
   "group": "Panes",
   "aliases": [
    "max"
   ],
   "handler": "client"
  },
  "pane.collapse": {
   "title": "Collapse / expand pane",
   "group": "Panes",
   "undoable": true,
   "handler": "client"
  },
  "pane.swap": {
   "title": "Swap with the next pane",
   "group": "Panes",
   "when": "panes > 1",
   "reason": "needs two panes",
   "undoable": true,
   "handler": "client"
  },
  "pane.rotate": {
   "title": "Rotate the split",
   "group": "Panes",
   "when": "panes > 1",
   "reason": "needs two panes",
   "undoable": true,
   "handler": "client"
  },
  "pane.equalize": {
   "title": "Equal sizes",
   "group": "Panes",
   "when": "panes > 1",
   "reason": "needs two panes",
   "undoable": true,
   "handler": "client"
  },
  "pane.resize": {
   "title": "Resize pane",
   "group": "Panes",
   "args": [
    {
     "name": "dir",
     "type": "enum",
     "values": [
      "<",
      ">",
      "+",
      "-"
     ]
    }
   ],
   "sticky": true,
   "undoable": true,
   "handler": "client"
  },
  "pane.group": {
   "title": "Cycle link group (A → B → none)",
   "group": "Panes",
   "undoable": true,
   "handler": "client"
  },
  "pane.pin": {
   "title": "Pin / unpin pane",
   "group": "Panes",
   "undoable": true,
   "handler": "client"
  },
  "layout.menu": {
   "title": "Layouts: save, load, reset",
   "group": "Panes",
   "handler": "client"
  },
  "layout.save": {
   "title": "Save this layout",
   "group": "Panes",
   "aliases": [
    "layout-save"
   ],
   "args": [
    {
     "name": "name",
     "type": "text"
    }
   ],
   "handler": "both"
  },
  "layout.load": {
   "title": "Load a saved layout",
   "group": "Panes",
   "aliases": [
    "layout-load"
   ],
   "args": [
    {
     "name": "name",
     "type": "layout"
    }
   ],
   "undoable": true,
   "handler": "client"
  },
  "layout.reset": {
   "title": "Reset this mode's layout",
   "group": "Panes",
   "aliases": [
    "layout-reset"
   ],
   "undoable": true,
   "handler": "client"
  },
  "section.toggle": {
   "title": "Fold / unfold the section",
   "group": "Sections",
   "when": "pane.sections",
   "reason": "this pane has no sections",
   "handler": "client"
  },
  "section.all": {
   "title": "Fold / unfold all sections",
   "group": "Sections",
   "when": "pane.sections",
   "reason": "this pane has no sections",
   "handler": "client"
  },
  "layer.escape": {
   "title": "Back to Normal",
   "group": "Global",
   "handler": "client"
  },
  "cmdline.open": {
   "title": "Command line",
   "group": "Global",
   "handler": "client"
  },
  "search.open": {
   "title": "Search in this view",
   "group": "Global",
   "when": "pane.search",
   "reason": "this view has no search yet",
   "handler": "client"
  },
  "help.context": {
   "title": "Keys of this context",
   "group": "Global",
   "aliases": [
    "keys"
   ],
   "handler": "client"
  },
